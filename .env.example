# Copy to .env — used by the app when you run it on your machine (dotenv-rails)
# and by docker compose for port mapping.

# Ports published by docker compose on localhost
POSTGRES_PORT=5432
REDIS_PORT=6379
WEB_PORT=3000

# How the locally running app reaches the dockerized services
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
REDIS_URL=redis://localhost:6379/0

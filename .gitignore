# See https://help.github.com/articles/ignoring-files for more about ignoring files.

/.bundle

# Ignore all environment files.
/.env*
!/.env.example

# Ignore all logfiles and tempfiles.
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# Ignore pidfiles, but keep the directory.
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Ignore storage (uploaded files in development and any SQLite databases).
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep

/public/assets

# Ignore master key for decrypting credentials and more.
/config/master.key

.byebug_history
.DS_Store

# Bundler / gems
/vendor/bundle
*.gem

# Test & tooling output
/coverage/
/test/reports/
/spec/examples.txt
/node_modules/
/yarn-error.log
/.yardoc/
/doc/
.rspec_status

# Credentials
/config/credentials/*.key

# IDE / editors
/.idea/
/.vscode/
/.fleet/
/.zed/
*.iml
*.swp
*.swo
*~
.project
.tool-versions.local

# Ruby version managers (we use .ruby-version)
.rvmrc
.ruby-gemset

# OS junk
.DS_Store
Thumbs.db
._*
